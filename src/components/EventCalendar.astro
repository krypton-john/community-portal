---
import type { NewsPost } from '../utils/posts';
import { categoryLabel, formatDateTime, getSlug } from '../utils/posts';

interface Props {
  events: NewsPost[];
  year: number;
  month: number;
  days: (Date | null)[];
  eventsByDay: Map<string, NewsPost[]>;
}

const { events, year, month, days, eventsByDay } = Astro.props;

const monthName = new Date(year, month, 1).toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});

const weekDays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

function dayKey(date: Date): string {
  return `${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`;
}

const today = new Date();
---

<section aria-label="Events calendar">
  <h2 class="mb-4 text-xl font-semibold text-slate-900">{monthName}</h2>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <div class="grid min-w-[320px] grid-cols-7 border-b border-slate-200 bg-slate-50">
      {weekDays.map((day) => (
        <div class="px-1 py-2 text-center text-xs font-semibold text-slate-500 sm:px-2 sm:text-sm">
          {day}
        </div>
      ))}
    </div>

    <div class="grid grid-cols-7">
      {days.map((date, index) => {
        if (!date) {
          return <div class="min-h-[4.5rem] border-b border-r border-slate-100 bg-slate-50/50 sm:min-h-[5.5rem]" />;
        }

        const key = dayKey(date);
        const dayEvents = eventsByDay.get(key) ?? [];
        const isToday =
          date.getFullYear() === today.getFullYear() &&
          date.getMonth() === today.getMonth() &&
          date.getDate() === today.getDate();

        return (
          <div
            class:list={[
              'min-h-[4.5rem] border-b border-r border-slate-100 p-1 sm:min-h-[5.5rem] sm:p-2',
              isToday ? 'bg-brand-50' : 'bg-white',
            ]}
          >
            <span
              class:list={[
                'inline-flex h-6 w-6 items-center justify-center rounded-full text-xs font-medium sm:text-sm',
                isToday ? 'bg-brand-600 text-white' : 'text-slate-700',
              ]}
            >
              {date.getDate()}
            </span>
            <ul class="mt-1 space-y-0.5">
              {dayEvents.slice(0, 2).map((event) => {
                const slug = getSlug(event);
                return (
                  <li>
                    <a
                      href={`/news/${slug}`}
                      class="block truncate rounded px-1 text-[10px] font-medium text-brand-700 hover:bg-brand-100 sm:text-xs"
                      title={event.data.title}
                    >
                      {event.data.title}
                    </a>
                  </li>
                );
              })}
              {dayEvents.length > 2 && (
                <li class="px-1 text-[10px] text-slate-500 sm:text-xs">
                  +{dayEvents.length - 2} more
                </li>
              )}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>

<section class="mt-10" aria-label="Upcoming events">
  <h2 class="mb-4 text-xl font-semibold text-slate-900">Upcoming (next 30 days)</h2>
  {events.length === 0 ? (
    <p class="text-slate-600">No upcoming events scheduled.</p>
  ) : (
    <ul class="space-y-3">
      {events.map((event) => {
        const slug = getSlug(event);
        return (
          <li class="rounded-lg border border-slate-200 bg-white p-4">
            <a href={`/news/${slug}`} class="font-semibold text-slate-900 hover:text-brand-600">
              {event.data.title}
            </a>
            <p class="mt-1 text-sm text-slate-600">
              {event.data.eventStart && formatDateTime(event.data.eventStart)}
              {event.data.location && ` · ${event.data.location}`}
            </p>
            <span class="mt-2 inline-block rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">
              {categoryLabel(event.data.category)}
            </span>
          </li>
        );
      })}
    </ul>
  )}
</section>
