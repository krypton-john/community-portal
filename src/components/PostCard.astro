---
import type { NewsPost } from '../utils/posts';
import {
  categoryColor,
  categoryLabel,
  formatDateTime,
  getSlug,
  getUpdatedAt,
  isExpired,
} from '../utils/posts';

interface Props {
  post: NewsPost;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const slug = getSlug(post);
const expired = isExpired(post);
---

<article
  class:list={[
    'rounded-lg border bg-white p-4 shadow-sm transition-shadow hover:shadow-md',
    expired ? 'border-slate-200 opacity-75' : 'border-slate-200',
    compact ? 'p-3' : 'p-5',
  ]}
>
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${categoryColor(post.data.category)}`}>
      {categoryLabel(post.data.category)}
    </span>
    {post.data.verified && (
      <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800">
        Verified
      </span>
    )}
    {post.data.urgent && !expired && (
      <span class="rounded-full bg-red-600 px-2.5 py-0.5 text-xs font-medium text-white">
        Urgent
      </span>
    )}
    {expired && (
      <span class="rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-medium text-slate-600">
        Ended
      </span>
    )}
  </div>

  <h2 class:list={['font-semibold text-slate-900', compact ? 'text-base' : 'text-lg']}>
    <a href={`/news/${slug}`} class="hover:text-brand-600">
      {post.data.title}
    </a>
  </h2>

  <p class="mt-2 text-sm text-slate-500">
    {post.data.source}
    · Published {formatDateTime(post.data.publishedAt)}
    {getUpdatedAt(post).getTime() !== post.data.publishedAt.getTime() && (
      <> · Updated {formatDateTime(getUpdatedAt(post))}</>
    )}
  </p>

  {!compact && post.data.location && (
    <p class="mt-1 text-sm text-slate-600">📍 {post.data.location}</p>
  )}
</article>
