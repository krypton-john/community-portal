---
interface Props {
  title: string;
  subtitle?: string;
  tone?: 'teal' | 'gold' | 'coral';
}

const { title, subtitle, tone = 'teal' } = Astro.props;

const tones = {
  teal: 'bg-community-teal text-white',
  gold: 'bg-community-gold text-community-teal-dark',
  coral: 'bg-community-coral text-white',
};
---

<section class={`${tones[tone]} py-10 sm:py-14`}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h1 class="font-display text-3xl font-bold sm:text-4xl">{title}</h1>
    {subtitle && <p class="section-lead mt-3 opacity-90">{subtitle}</p>}
  </div>
</section>
