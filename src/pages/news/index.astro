---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, siteConfig } from '../../config';
import {
  filterActivePosts,
  filterByCategory,
  filterVerified,
  sortByPublishedDesc,
} from '../../utils/posts';

const categoryParam = Astro.url.searchParams.get('category');
const verifiedParam = Astro.url.searchParams.get('verified');

const allPosts = (await getCollection('news')).sort(sortByPublishedDesc);
const verifiedOnly = verifiedParam !== 'all';
let posts = filterActivePosts(allPosts);
posts = filterByCategory(posts, categoryParam);
posts = filterVerified(posts, verifiedOnly);

const activeCategory = categories.find((c) => c.id === categoryParam);
---

<BaseLayout
  title="News"
  description="Browse verified community news, council notices, traffic updates, and local announcements."
>
  <PageHero
    title="Community news"
    subtitle="Verified updates from council, community groups, and local editors."
    tone="teal"
  />

  <section class="bg-white">
    <div class="section-inner !pt-10">
      <div class="mb-8 flex flex-wrap gap-2" role="navigation" aria-label="Category filters">
        <a
          href={verifiedOnly ? '/news' : '/news?verified=all'}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-semibold transition',
            !categoryParam
              ? 'bg-community-teal text-white'
              : 'bg-community-teal-light text-community-teal-dark hover:bg-community-teal/20',
          ]}
        >
          All
        </a>
        {
          categories.map((cat) => (
            <a
              href={`/news?category=${cat.id}${verifiedOnly ? '' : '&verified=all'}`}
              class:list={[
                'rounded-full px-4 py-2 text-sm font-semibold transition',
                categoryParam === cat.id
                  ? 'bg-community-teal text-white'
                  : 'bg-community-teal-light text-community-teal-dark hover:bg-community-teal/20',
              ]}
            >
              {cat.label}
            </a>
          ))
        }
      </div>

      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-600">
          {activeCategory ? `${activeCategory.label} · ` : ''}
          {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        </p>
        {
          verifiedOnly ? (
            <a href={`/news?verified=all${categoryParam ? `&category=${categoryParam}` : ''}`} class="text-sm font-semibold text-community-teal hover:underline">
              Show all community posts
            </a>
          ) : (
            <a href={`/news${categoryParam ? `?category=${categoryParam}` : ''}`} class="text-sm font-semibold text-community-teal hover:underline">
              Show verified only
            </a>
          )
        }
      </div>

      {
        posts.length === 0 ? (
          <p class="rounded-2xl bg-community-teal-light p-12 text-center text-slate-600">
            No posts match these filters.
          </p>
        ) : (
          <div class="grid gap-5 sm:grid-cols-2">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
