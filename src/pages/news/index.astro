---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../config';
import {
  filterActivePosts,
  filterByCategory,
  filterVerified,
  sortByPublishedDesc,
} from '../../utils/posts';

const categoryParam = Astro.url.searchParams.get('category');
const verifiedParam = Astro.url.searchParams.get('verified');

const allPosts = (await getCollection('news')).sort(sortByPublishedDesc);
const verifiedOnly = verifiedParam !== 'all';
let posts = filterActivePosts(allPosts);
posts = filterByCategory(posts, categoryParam);
posts = filterVerified(posts, verifiedOnly);

const activeCategory = categories.find((c) => c.id === categoryParam);
---

<BaseLayout
  title="News"
  description="Browse verified community news, council notices, traffic updates, and local announcements."
>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <header class="mb-6">
      <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Community news</h1>
      <p class="mt-2 text-slate-600">
        Filter by category. Verified posts are from official sources or editor-approved
        contributors.
      </p>
    </header>

    <div class="mb-6 flex flex-wrap gap-2" role="navigation" aria-label="Category filters">
      <a
        href={verifiedOnly ? '/news' : '/news?verified=all'}
        class:list={[
          'rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
          !categoryParam
            ? 'bg-brand-600 text-white'
            : 'bg-white text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50',
        ]}
      >
        All
      </a>
      {categories.map((cat) => (
        <a
          href={`/news?category=${cat.id}${verifiedOnly ? '' : '&verified=all'}`}
          class:list={[
            'rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
            categoryParam === cat.id
              ? 'bg-brand-600 text-white'
              : 'bg-white text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50',
          ]}
        >
          {cat.label}
        </a>
      ))}
    </div>

    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-slate-600">
        {activeCategory ? `${activeCategory.label} · ` : ''}
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        {verifiedOnly ? ' (verified only)' : ' (including community posts)'}
      </p>
      {verifiedOnly ? (
        <a href={`/news?verified=all${categoryParam ? `&category=${categoryParam}` : ''}`} class="text-sm font-medium text-brand-600 hover:underline">
          Show all community posts
        </a>
      ) : (
        <a href={`/news${categoryParam ? `?category=${categoryParam}` : ''}`} class="text-sm font-medium text-brand-600 hover:underline">
          Show verified only
        </a>
      )}
    </div>

    {posts.length === 0 ? (
      <p class="rounded-lg border border-slate-200 bg-white p-8 text-center text-slate-600">
        No posts match these filters.
      </p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
