---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import {
  categoryColor,
  categoryLabel,
  formatDateTime,
  getSlug,
  getUpdatedAt,
  isExpired,
} from '../../utils/posts';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: getSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const expired = isExpired(post);
const description = `${post.data.source}: ${post.data.title}`;
---

<BaseLayout title={post.data.title} description={description} ogType="article">
  <section class="bg-community-teal-light py-10 sm:py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      {expired && (
        <div class="mb-6 rounded-xl bg-amber-100 px-4 py-3 text-sm text-amber-900" role="status">
          This notice has ended. Information is kept for reference.
        </div>
      )}

      <div class="mb-4 flex flex-wrap gap-2">
        <span class={`rounded-full px-3 py-1 text-xs font-bold ${categoryColor(post.data.category)}`}>
          {categoryLabel(post.data.category)}
        </span>
        {post.data.verified && (
          <span class="rounded-full bg-community-teal px-3 py-1 text-xs font-bold text-white">
            Verified
          </span>
        )}
        {post.data.urgent && !expired && (
          <span class="rounded-full bg-community-coral px-3 py-1 text-xs font-bold text-white">
            Urgent
          </span>
        )}
      </div>

      <h1 class="font-display text-3xl font-bold text-community-navy sm:text-4xl">{post.data.title}</h1>

      <p class="mt-4 text-sm text-slate-600">
        {post.data.source} · Published {formatDateTime(post.data.publishedAt)}
        {getUpdatedAt(post).getTime() !== post.data.publishedAt.getTime() && (
          <> · Updated {formatDateTime(getUpdatedAt(post))}</>
        )}
      </p>
    </div>
  </section>

  <article class="bg-white">
    <div class="section-inner !py-10">
      <div class="prose-content mx-auto max-w-3xl">
        <Content />
      </div>

      <footer class="mx-auto mt-10 max-w-3xl border-t border-slate-200 pt-6">
        <a href={withBase('/news')} class="font-semibold text-community-teal hover:underline">← Back to all news</a>
      </footer>
    </div>
  </article>
</BaseLayout>
