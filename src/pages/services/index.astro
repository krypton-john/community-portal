---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DirectoryTable from '../../components/DirectoryTable.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';
import { serializeListingsForClient, sortByName } from '../../utils/services';
---

<BaseLayout
  title="Local Directory"
  description={`Searchable directory of tradespeople and local businesses in ${siteConfig.town}.`}
>
  <PageHero
    title="Local directory"
    subtitle="Plumbers, electricians, mechanics & more — trusted local people for local jobs."
    tone="coral"
  />

  <section class="bg-community-cream">
    <div class="section-inner !pt-10">
      <DirectoryTable listings={serializeListingsForClient((await getCollection('services')).sort(sortByName))} />

      <p class="mt-8 text-center text-sm text-slate-600">
        Know a business that should be listed? Email{' '}
        <a href={`mailto:${siteConfig.tipEmail}`} class="font-semibold text-community-teal hover:underline">
          {siteConfig.tipEmail}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
