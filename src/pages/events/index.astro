---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EventCalendar from '../../components/EventCalendar.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';
import {
  eventsOnDate,
  filterActivePosts,
  getCalendarDays,
  getEventPosts,
  getUpcomingEvents,
  sortByPublishedDesc,
} from '../../utils/posts';

const allPosts = (await getCollection('news')).sort(sortByPublishedDesc);
const activePosts = filterActivePosts(allPosts);
const eventPosts = getEventPosts(activePosts);
const upcoming = getUpcomingEvents(activePosts, 30);

const now = new Date();
const year = now.getFullYear();
const month = now.getMonth();
const days = getCalendarDays(year, month);

function dayKey(date: Date): string {
  return `${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`;
}

const eventsByDay = new Map<string, typeof eventPosts>();
for (const day of days) {
  if (!day) continue;
  const key = dayKey(day);
  eventsByDay.set(key, eventsOnDate(eventPosts, day));
}
---

<BaseLayout
  title="Events"
  description={`Local community events calendar and upcoming listings for ${siteConfig.town}.`}
>
  <PageHero
    title="Events calendar"
    subtitle="What's on in Monasterevin this month and beyond."
    tone="gold"
  />

  <section class="bg-white">
    <div class="section-inner !pt-10">
      <EventCalendar
        events={upcoming}
        year={year}
        month={month}
        days={days}
        eventsByDay={eventsByDay}
      />

      <p class="mt-8 text-sm text-slate-500">
        Showing {new Date(year, month, 1).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}.
        <a href="/news?category=event" class="font-semibold text-community-teal hover:underline">
          Browse all event posts
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
