---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import UrgentBanner from '../components/UrgentBanner.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import {
  filterActivePosts,
  filterVerified,
  getSlug,
  isUrgentActive,
  sortByPublishedDesc,
} from '../utils/posts';
import { withBase } from '../utils/paths';

const FEATURED_SLUG = 'leaving-junior-cert-best-of-luck-2026';

const allPosts = (await getCollection('news')).sort(sortByPublishedDesc);
const activePosts = filterActivePosts(allPosts);
const urgentPosts = activePosts.filter((post) => isUrgentActive(post));
const verifiedPosts = filterVerified(activePosts, true);

const featured = verifiedPosts.find((p) => getSlug(p) === FEATURED_SLUG) ?? verifiedPosts[0];
const otherNews = featured
  ? verifiedPosts.filter((p) => getSlug(p) !== getSlug(featured)).slice(0, 3)
  : [];
---

<BaseLayout>
  {urgentPosts.length > 0 && (
    <section class="bg-white px-4 pt-6 sm:px-6" aria-label="Urgent alerts">
      <div class="mx-auto max-w-6xl">
        <UrgentBanner posts={urgentPosts} />
      </div>
    </section>
  )}

  <!-- Section 1: About banner -->
  <section class="relative overflow-hidden bg-community-teal text-white">
    <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-community-gold/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-16 -left-16 h-48 w-48 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
    <div class="section-inner relative">
      <p class="text-sm font-bold uppercase tracking-widest text-community-gold">Welcome neighbours</p>
      <h1 class="section-title mt-2 max-w-3xl font-display">
        {siteConfig.town}'s place for local news, events &amp; trusted trades
      </h1>
      <p class="section-lead mt-4 max-w-2xl text-white/90">
        {siteConfig.name} brings together verified council notices, community updates, and a
        directory of local businesses — so you can find what you need without digging through
        group chat.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={withBase('/news')} class="btn-primary">Read the news</a>
        <a href={withBase('/services')} class="btn-secondary">Browse directory</a>
      </div>
    </div>
  </section>

  <!-- Section 2: Latest news -->
  <section class="bg-white" aria-label="Latest news">
    <div class="section-inner">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-community-coral">Latest news</p>
          <h2 class="section-title mt-1 text-community-navy">What's happening in {siteConfig.town}</h2>
        </div>
        <a href={withBase('/news')} class="btn-outline">View all news</a>
      </div>

      {
        featured && (
          <article class="mb-8 overflow-hidden rounded-2xl bg-community-gold-light shadow-md ring-1 ring-community-gold/30">
            <div class="grid lg:grid-cols-5">
              <div class="bg-community-gold px-6 py-3 lg:col-span-5 lg:px-8">
                <span class="text-xs font-bold uppercase tracking-wide text-community-teal-dark">
                  Featured · Community
                </span>
              </div>
              <div class="p-6 lg:col-span-5 lg:p-8">
                <h3 class="font-display text-2xl font-bold text-community-navy sm:text-3xl">
                  <a href={withBase(`/news/${getSlug(featured)}`)} class="hover:text-community-teal">
                    {featured.data.title}
                  </a>
                </h3>
                <p class="mt-4 text-base leading-relaxed text-slate-700">
                  This week, students across Monasterevin begin their Leaving &amp; Junior Cert
                  exams. To every student — <strong>the very best of luck</strong>. The whole
                  community is behind you.
                </p>
                <p class="mt-3 text-base leading-relaxed text-slate-700">
                  Students and parents can find free, practical advice in the{' '}
                  <a
                    href="https://spunout.ie/education/leaving-cert-cao/leaving-cert-preparation-guide/"
                    class="font-semibold text-community-teal underline hover:text-community-teal-dark"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    SpunOut Leaving Cert preparation guide
                  </a>
                  — covering study, wellbeing, and navigating this important time.
                </p>
                <a
                  href={withBase(`/news/${getSlug(featured)}`)}
                  class="mt-6 inline-flex items-center gap-2 font-semibold text-community-coral hover:text-community-coral-dark"
                >
                  Read full post →
                </a>
              </div>
            </div>
          </article>
        )
      }

      {
        otherNews.length > 0 && (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {otherNews.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Section 3: Trades directory -->
  <section class="bg-community-teal-light" aria-label="Local directory">
    <div class="section-inner">
      <div class="overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-community-teal/10">
        <div class="grid lg:grid-cols-10">
          <div class="flex items-center bg-community-teal-light p-8 lg:col-span-7 lg:p-12">
            <blockquote class="font-display text-xl font-semibold leading-snug text-community-teal-dark sm:text-2xl lg:text-3xl">
              "Here you can easily find your plumbers, electricians, mechanics &amp; more — local
              people for local jobs, right when you need them."
            </blockquote>
          </div>
          <div class="flex flex-col items-start justify-center bg-community-coral p-8 text-white lg:col-span-3 lg:items-end lg:p-10 lg:text-right">
            <p class="text-sm font-bold uppercase tracking-wide text-white/80">Local directory</p>
            <h2 class="mt-2 font-display text-2xl font-bold">Find out more here</h2>
            <p class="mt-3 text-sm text-white/90">
              Searchable listings for trades &amp; businesses in {siteConfig.town}.
            </p>
            <a
              href={withBase('/services')}
              class="mt-6 inline-flex rounded-full bg-white px-6 py-3 text-sm font-bold text-community-coral shadow transition hover:bg-community-gold-light"
            >
              Browse directory →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Footer (uniform — rendered in BaseLayout) -->
</BaseLayout>
