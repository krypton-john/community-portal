---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { siteConfig } from '../../config';
---

<BaseLayout title="About" description={`About the ${siteConfig.name} and how to submit news tips.`}>
  <PageHero
    title="About this portal"
    subtitle="Built for neighbours — keeping Monasterevin connected."
    tone="teal"
  />

  <section class="bg-white">
    <div class="section-inner !pt-10">
      <div class="prose-content mx-auto max-w-3xl">
        <p>
          {siteConfig.name} is a community-run hub for {siteConfig.town} residents. It brings
          together verified council notices, traffic updates, local events, and a directory of
          trusted trades — so you do not have to scroll through group chat to stay informed.
        </p>

        <h2>What counts as verified?</h2>
        <p>
          Posts marked <strong>Verified</strong> come from official sources (Kildare County Council,
          Gardaí, schools, Irish Water) or have been checked by a community editor.
        </p>

        <h2>Submit a news tip</h2>
        <p>
          Email our editors at{' '}
          <a href={`mailto:${siteConfig.tipEmail}`}>{siteConfig.tipEmail}</a> with what happened,
          when, where, and any official source links.
        </p>

        <h2>Editors</h2>
        <p>
          Trusted editors can manage content via the{' '}
          <a href={`${import.meta.env.BASE_URL}admin/`}>site admin panel</a>.
        </p>

        <h2>Coming soon</h2>
        <ul>
          <li>Community sharing and borrowing hub</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
